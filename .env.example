# Copia esto a .env y cambia los valores.
#
#     cp .env.example .env

# ======== Obligatorio ========

# Clave de administrador de la base de datos
#     openssl rand -base64 24
LACRE_DB_CLAVE=

# Clave del rol lacre_app, con el que se conecta la aplicación: solo tiene permisos
# de lectura y escritura (insercion)
#     openssl rand -base64 24
LACRE_DB_CLAVE_APLICACION=

# Credencial con la que se llama a la API.
#     openssl rand -base64 32
LACRE_API_CLAVE=

# URL base del servicio de cotejo que va dentro del código QR de cada factura.
# Producción: https://www2.agenciatributaria.gob.es/wlpl/TIKE-CONT/ValidarQR?
# Preproducción: https://prewww2.aeat.es/wlpl/TIKE-CONT/ValidarQR?
LACRE_QR_URL_BASE=https://prewww2.aeat.es/wlpl/TIKE-CONT/ValidarQR?

# ======== Para presentar a la AEAT ========

# Endpoint de remisión. Sin esta variable, lacre presenta en el entorno de PRUEBAS.
# Producción: https://www1.agenciatributaria.gob.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/VerifactuSOAP
# Producción con certificado de sello: https://www10.agenciatributaria.gob.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/VerifactuSOAP
# LACRE_AEAT_ENDPOINT=

# Información del sistema informático.
# LACRE_PRODUCTOR_NOMBRE=
# LACRE_PRODUCTOR_NIF=
# LACRE_SIF_INSTALACION=0001

# Certificados: un <NIF>.p12 por obligado en esta carpeta, y la contraseña de cada uno con
# su NIF en el nombre de la variable.
# LACRE_CERTIFICADOS_HOST=./certificados
# LACRE_CERTIFICADOS_CONTRASENAS_12345678Z=

# ======== Opcional ========

# Usuario y clave de la consola de operación.
#     openssl rand -base64 24
LACRE_CONSOLA_USUARIO=lacre
LACRE_CONSOLA_CLAVE=
