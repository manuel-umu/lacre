# Copia esto a .env y cambia los valores. 
#
#     cp .env.example .env
#
# Clave de administrador de la base de datos
#     openssl rand -base64 24
LACRE_DB_CLAVE=

# Clave del rol lacre_app, con el que se conecta la aplicación: solo tiene permisos
# de lectura y escritura (insercion)
#     openssl rand -base64 24
LACRE_DB_CLAVE_APLICACION=

# Credencial con la que se llama a la API.
#     openssl rand -base64 32
LACRE_API_CLAVE=

# URL base del servicio de cotejo que va dentro del código QR de cada factura. 
# Producción: https://www2.agenciatributaria.gob.es/wlpl/TIKE-CONT/ValidarQR?
# Preproducción: https://prewww2.aeat.es/wlpl/TIKE-CONT/ValidarQR?
LACRE_QR_URL_BASE=https://prewww2.aeat.es/wlpl/TIKE-CONT/ValidarQR?
