# Copia esto a .env y cambia los valores. Compose lo lee solo, y .env está en el .gitignore.
#
#     cp .env.example .env
#
# Sin estas cuatro variables compose no arranca nada, ni siquiera construye la imagen: un
# despliegue a medias tiene que fallar antes de la primera factura.

# Clave del propietario de la base de datos, con la que migra Flyway.
#     openssl rand -base64 24
LACRE_DB_CLAVE=cambiame

# Clave del rol lacre_app, con el que se conecta la aplicación: solo lee e inserta en el registro
# de facturación. Se le asigna en cada arranque, así que rotarla es cambiarla aquí y reiniciar.
#     openssl rand -base64 24
LACRE_DB_CLAVE_APLICACION=cambiame-tambien

# Credencial con la que el ERP llama a la API. Una por despliegue.
#     openssl rand -base64 32
LACRE_API_CLAVE=cambiame-al-menos-32-caracteres-de-verdad

# URL base del servicio de cotejo que va DENTRO del código QR de cada factura. Producción es
# https://www2.agenciatributaria.gob.es/wlpl/TIKE-CONT/ValidarQR?
LACRE_QR_URL_BASE=https://prewww2.aeat.es/wlpl/TIKE-CONT/ValidarQR?
